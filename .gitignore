# Keep installed executables and extracted game data out of this research repo.
node_modules/
dist/
# Local third-party research/build checkouts; keep them off Git without deleting local copies.
/references/
# Local Git worktrees are development state, not distributable submodules.
/.worktrees/
__pycache__/
*.py[cod]
*.exe
*.dll
*.gpr
*.rep/
*.pdb
*.map
*.bin
*.dmp
*.pcap
*.pcapng
captures/
backups/
runtime-logs/
tooling/native/
*.gar
.env
.cache/
# Generated machine-local MCP registration; recreate with scripts/integrate-rea.mjs.
.codex/config.toml
.codex/config.toml.rea-*
scripts/inspect-movement-video.cjs

# Generated static research wiki and its local npm cache.
wiki/_site/
wiki/.npm-cache/

# Keep local test files (including generated sidecars) out of new Git additions.
*_test*

# Generated Godot migration analysis and comparison artifacts.
/godot-client/tools/nwn79/*.cjs
/godot-client/tools/nwn79/*-handoff*.json
/godot-client/tools/nwn79/*-followup*.json
/godot-client/tools/nwn79/*-reconciliation*.json
/godot-client/tools/nwn79/*-inventory*.json
