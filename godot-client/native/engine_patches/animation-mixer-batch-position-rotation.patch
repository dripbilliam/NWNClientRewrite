@@ -831,6 +831,19 @@ void Node3D::set_rotation(const Vector3 &p_euler_rad) {
 	fti_notify_node_changed();
 }
 
+bool Node3D::_try_set_animation_position_and_rotation(const Vector3 &p_position, const Quaternion &p_rotation) {
+	if (!Thread::is_main_thread() || !is_inside_tree() || data.notify_local_transform ||
+			get_tree()->get_scene_tree_fti().is_enabled()) {
+		return false;
+	}
+
+	// Rotation publishes the same dirty subtree and queues its notifications once.
+	// Keep its normal Euler, basis and scale handling.
+	data.local_transform.origin = p_position;
+	set_rotation(p_rotation.get_euler());
+	return true;
+}
+
