extends "res://tests/native_chat_hud_test.gd"
const Preferences=preload("res://systems/native_data/chat_preferences.gd")
const Options=preload("res://systems/native_chat_options.gd")
const Settings=preload("res://systems/native_render_settings.gd")
const Session=preload("res://native_session_world.gd")
func reconnected(previous,current) -> void:
	check(current.preferences.width==640 and current.preferences.font_size==16 and current.preferences.x==30 and current.panes[0].label.get_theme_font_size("normal_font_size")==16,"New gameplay owner applies saved chat preferences as soon as source controls activate")
	check(current.options_window==previous.options_window,"Reconnect reuses the same client settings window")
	current.options_window.change("width",680); await frames()
	check(current.preferences.width==680 and previous.preferences.width==640 and previous.closed,"Preferences after reconnect update only the live owner and cannot revive the retired chat frame")
func button(surface: SubViewport,control: Control) -> void:
	var point:=control.get_global_rect().get_center(); await mouse(surface,point,true); await mouse(surface,point,false)
func drag_control(surface: SubViewport,control: Control,delta: Vector2,alt: bool=false) -> void:
	var point:=control.get_global_rect().get_center()
	var event:=InputEventMouseButton.new(); event.position=point; event.global_position=point; event.button_index=MOUSE_BUTTON_LEFT; event.pressed=true; event.button_mask=MOUSE_BUTTON_MASK_LEFT; event.alt_pressed=alt
	var motion:=InputEventMouseMotion.new(); motion.position=point; motion.global_position=point; surface.push_input(motion,true); await frames(); surface.push_input(event,true); await frames()
	motion=InputEventMouseMotion.new(); motion.position=point+delta; motion.global_position=motion.position; motion.relative=delta; motion.button_mask=MOUSE_BUTTON_MASK_LEFT; motion.alt_pressed=alt; surface.push_input(motion,true); await frames()
	event=InputEventMouseButton.new(); event.position=point+delta; event.global_position=event.position; event.button_index=MOUSE_BUTTON_LEFT; event.pressed=false; event.alt_pressed=alt; surface.push_input(event,true); await frames()
func adjustments(frame,chat,surface,art,args) -> void:
	var cleaned:=Preferences.clean({"width":-1,"x":INF,"bottom":-10,"font_size":99,"opacity":-3,"history":9,"locked":"false","timestamps":true})
	check(cleaned.width==320 and cleaned.x==0 and cleaned.bottom==0 and cleaned.font_size==28 and cleaned.opacity==0 and cleaned.history==50 and not cleaned.locked and cleaned.timestamps,"Malformed persisted chat settings are bounded without coercing strings into flags")
	var config:=ConfigFile.new(); config.load(frame.storage); config.set_value("unrelated","keep",42); config.save(frame.storage)
	frame.set_split(false); await frames(); var count: int=art.models.requests.size()
	await drag_control(surface,frame.panes[0].grip,Vector2(120,0))
	check(frame.preferences.width==840 and frame.panes[0].handle.size.x>839 and frame.panes[0].scroll.size.x>700,"Real top-right grip changes chat width and text wrapping")
	check(frame.panes[0].handle_image is NinePatchRect and frame.panes[0].handle_image.patch_margin_left==12 and frame.panes[0].handle_image.patch_margin_right==12 and chat.entry.scale==Vector2.ONE,"Resize preserves bar endcaps and input glyph proportions")
	await drag_control(surface,frame.panes[0].handle,Vector2(70,-40),true)
	check(frame.preferences.x==70 and frame.preferences.bottom==40 and frame.panes[0].container.position.x==70 and frame.entry_clip.position.y==708,"Real Alt-drag moves chat and the input strip together")
	check(art.models.requests.size()==count,"Dragging width and position reuses prepared background artwork instead of requesting new raster jobs")
	var saved:=Preferences.load_settings(frame.storage); config.load(frame.storage)
	check(saved.width==840 and saved.x==70 and saved.bottom==40 and config.get_value("unrelated","keep")==42,"Drag completion persists layout without overwriting unrelated preferences")
	frame.open_settings(); await frames(4); var window=frame.options_window
	check(window.visible and Options.acquire(surface,frame.storage)==window and frame.blocks_pointer(window.get_global_rect().get_center()),"One shared chat settings window is reused and owns its actual input region")
	await button(surface,window.fields.timestamps); await button(surface,window.fields.seconds)
	chat.append_message({"text":"Timestamp sample","channel":6,"received_at":"09:08:07"}); await frames(3)
	check(frame.panes[0].label.get_parsed_text().contains("[09:08:07] Timestamp sample"),"Actual timestamp controls display local receipt time including optional seconds")
	await button(surface,window.fields.show_party); await frames()
	check(not frame.panes[0].label.get_parsed_text().contains("Timestamp sample") and chat.rows.any(func(row):return row.get("text","")=="Timestamp sample"),"Display filters hide a channel without deleting its received history")
	await button(surface,window.fields.show_party); await frames()
	check(frame.panes[0].label.get_parsed_text().contains("Timestamp sample"),"Re-enabling a channel restores existing history")
	var spinner: SpinBox=window.fields.font_size; spinner.get_line_edit().grab_focus(); spinner.get_line_edit().text="18"; await key(surface,KEY_ENTER); await key(surface,KEY_ENTER,false)
	check(frame.preferences.font_size==18 and frame.panes[0].label.get_theme_font_size("normal_font_size")==18 and chat.entry.get_theme_font_size("font_size")==14,"Actual numeric text entry changes message size independently of original prompt glyph size")
	window.fields.opacity.value=35; await frames()
	check(is_equal_approx(frame.panes[0].background.modulate.a,0.35) and frame.panes[0].label.modulate.a==1.0 and is_equal_approx(frame.prompt_background.modulate.a,0.35),"Opacity affects background only while received text remains opaque")
	await button(surface,window.fields.compact_prompt); await frames()
	check(frame.entry_clip.size.x==762 and frame.prompt_background.size.x==840,"Optional compact input strip follows configured chat width")
	await button(surface,window.fields.locked); window.hide(); await frames()
	var height: float=frame.heights[0]; await drag_control(surface,frame.panes[0].handle,Vector2(0,-45)); await drag_control(surface,frame.panes[0].handle,Vector2(30,-30),true)
	check(frame.heights[0]==height and frame.preferences.x==70 and frame.preferences.bottom==40 and not frame.panes[0].grip.visible,"Lock prevents real height and movement gestures and removes the width grip")
	frame.open_settings(); await frames(); await button(surface,window.fields.locked); await button(surface,window.fields.autoscroll); window.hide(); await frames()
	frame.jump_latest(); await frames(4); var rail: VScrollBar=frame.panes[0].scroll.get_v_scroll_bar(); var previous:=rail.value
	for index in 8: chat.append_message({"text":"Do not auto-follow "+str(index)})
	await frames(4); check(absf(rail.value-previous)<1 and rail.value<rail.max_value-rail.page,"Auto-follow off preserves the reading position even when new messages arrive at the bottom")
	frame.open_settings(); await frames(); await button(surface,window.fields.latest); await frames(4)
	check(rail.value>=rail.max_value-rail.page-1,"Jump to latest explicitly reaches the newest received message")
	window.fields.history.value=50; await frames()
	for index in 60: chat.append_message({"system":true,"text":"System line "+str(index)})
	await frames(4)
	check(chat.rows.filter(func(row):return not row.system).size()==50 and chat.rows.filter(func(row):return row.system).size()==50,"Configured history is independently bounded for speech and server feedback")
	await button(surface,window.fields.split); await frames()
	check(frame.panes[1].container.visible and frame.panes[1].container.position.x==490 and frame.panes[1].label.get_parsed_text().contains("System line"),"Split chat keeps the chosen overall width and separates server feedback")
	saved=Preferences.load_settings(frame.storage); window.hide(); window.open_settings(); await frames()
	check(saved.font_size==18 and saved.split and saved.history==50 and not saved.autoscroll and window.fields.width.value==840 and window.fields.opacity.value==35,"Reopened settings read persisted filters, sizing, style and history preferences")
	await button(surface,window.fields.original); await frames(4)
	check(frame.preferences==Preferences.DEFAULTS and frame.heights==[134.0,134.0] and not frame.panes[1].container.visible and frame.panes[0].container.position==Vector2(0,666),"Original-style preset restores authored sizing, font, anchoring, channel visibility and combined mode")
	await key(surface,KEY_ESCAPE); await key(surface,KEY_ESCAPE,false)
	check(not window.visible,"Escape dismisses chat settings without sending speech")
	var settings:=Settings.new(); surface.add_child(settings); settings.setup(str(args.report)+".options.cfg",""); settings.show(); settings.tabs.current_tab=2; await frames(4)
	settings.chat_settings_requested.connect(func():window.open_settings())
	var chat_button: Button=settings.tabs.get_child(2).find_child("chat_settings_button",true,false)
	# The common builder IDs are metadata-free, so find by its translated caption.
	if chat_button==null:
		for child in settings.find_children("*","Button",true,false):
			if child.text=="Chat settings…": chat_button=child; break
	check(chat_button!=null,"Client Options Interface contains the shared Chat settings action")
	if chat_button!=null: await button(surface,chat_button); check(window.visible,"Actual Client Options button opens the shared chat preferences")
	window.hide(); settings.queue_free(); await frames()
	window.change("width",640); window.change("font_size",16); window.change("x",30)
