extends "res://tests/native_prepared_resource_store_test.gd"
# A pre-lock absence hint can only select original loading. Every real resource
# path still requires the existing publication lock, fresh row and reader pin.
func run() -> void:
	var store=fresh("missing-hints",200);var other:=Store.new()
	check(other.configure(str(args.root).path_join("missing-hints"),200),"Independent writer shares the owned namespace")
	var missing: Dictionary=store.acquire_read(A)
	check(missing.is_empty() and store.snapshot().read_hint_misses==1 and store.snapshot().read_strong_attempts==0,"Known absent optional derivative bypasses strong lease publication")
	check(store.snapshot().active_reads==0 and store.snapshot().pending_writes==0,"Absence hint creates no reader/write ownership")
	check(put(other,A,60),"Independent writer publishes a previously absent key")
	var reader: Dictionary=store.acquire_read(A)
	check(not reader.is_empty() and store.snapshot().read_strong_attempts==1,"Fresh shard sees another owner's newly published key instead of caching a negative")
	check(not other.invalidate(A) and other.failure=="read-pinned","Found hint still obtains the ordinary cross-owner reader pin")
	store.release_read(reader)
	check(other.invalidate(A),"Independent owner retires released artifact")
	var strong_before: int=int(store.snapshot().read_strong_attempts)
	missing=store.acquire_read(A)
	check(missing.is_empty() and store.snapshot().read_strong_attempts==strong_before+1,"Stale positive RAM hint is revalidated and cannot return the removed path")
	check(other._try_publish_lock(),"Independent writer holds the real publication lock")
	var lock_owner: String=other.directory.path_join("publish.lock/owner.json");var lock_bytes:=FileAccess.get_file_as_bytes(lock_owner)
	var before: Dictionary=store.snapshot();missing=store.acquire_read(C);var after: Dictionary=store.snapshot()
	check(missing.is_empty() and after.read_hint_misses==before.read_hint_misses+1 and after.read_strong_attempts==before.read_strong_attempts,"Absent key during publication selects safe original fallback without taking that lock")
	check(FileAccess.get_file_as_bytes(lock_owner)==lock_bytes and other._lock_nonce!="","Absence hint cannot modify or steal another owner's lock")
	other._unlock_publish();check(put(other,A,60),"Writer republishes original resource after removal")
	check(other._try_publish_lock(),"Writer holds its lock for a known-present key")
	missing=store.acquire_read(A)
	check(missing.is_empty() and store.failure=="busy","Known present key must still take the unchanged strong lease path")
	other._unlock_publish()
	reader=store.acquire_read(A);check(not reader.is_empty(),"Same read retries successfully after contention clears");store.release_read(reader)
	var prefix:=A.left(2);var shard: String=store.directory.path_join("index").path_join(prefix+".json");var shard_bytes:=FileAccess.get_file_as_bytes(shard)
	write_file(shard,"{}".to_utf8_buffer()) # Valid JSON, deliberately invalid store schema.
	var fresh_reader:=Store.new();check(fresh_reader.configure(str(args.root).path_join("missing-hints"),200),"Independent reader configures while index corruption is an explicit fixture")
	missing=fresh_reader.acquire_read(A)
	check(missing.is_empty() and fresh_reader.failure=="invalid-shard" and fresh_reader.snapshot().read_strong_attempts==1,"Invalid hint metadata is handled by the existing strong error/recovery path")
	write_file(shard,shard_bytes)
	reader=fresh_reader.acquire_read(A)
	check(not reader.is_empty(),"Restored metadata is retried without a persisted error or negative entry")
	fresh_reader.release_read(reader)
	check(store.close() and other.close() and fresh_reader.close(),"All hint owners close with no retained reader or write ticket")
	var result:={"success":failures.is_empty(),"checks":checks,"failures":failures,"scope":"Conservative pre-lock bounded-shard missing hints only; no negative persistence, stale-positive use, lock bypass for real reads or weakened cross-owner reader pins. No renderer/server/FPS claim."}
	write_file(str(args.report),JSON.stringify(result,"\t").to_utf8_buffer());print("PREPARED_RESOURCE_READ_HINT ",checks," checks ",failures.size()," failures");quit(0 if failures.is_empty() else 1)
