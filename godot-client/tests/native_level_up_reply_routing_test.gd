extends SceneTree
# Actual controller/result and Desktop routing. Only rendering is overridden;
# requests are generated by production input and echoed from captured commands.
const NativeOwner=preload("res://systems/native_level_up.gd")
const NativeDesktop=preload("res://systems/native_game_desktop.gd")
class View extends RefCounted:
	signal presentation_reset
	signal source_reopen
	var wanted:=false
	var request_serial:=0
	var source_active:=false
	var status:={"text":""}
	func open() -> void:wanted=true;request_serial+=1
	func reset() -> void:wanted=false;source_active=false;request_serial+=1;presentation_reset.emit()
class Desktop extends RefCounted:
	var generation:=1
	var area_id:=7
	var actor_id:=42
	var rules:=RefCounted.new()
	var closed:=false
	var native_lifetime:=123
	var known_lifetime:=456
	var commands: Array=[]
	func actor() -> Dictionary:return {"id":actor_id,"areaId":area_id,"objectType":5,"nativeLifetime":native_lifetime,"clientKnownLifetime":known_lifetime,"replicationRemoved":false}
	func command(value: Dictionary) -> void:
		var message:=value.duplicate(true);message.generation=generation;message.areaId=area_id;message.actorId=actor_id;commands.append(message)
class Controller extends NativeOwner:
	var renders:=0
	func select_class(id: int) -> void:draft={"classId":id}
	func render() -> void:renders+=1
var checks:=0
var failures: Array=[]
func check(value: bool,label: String) -> void:
	checks+=1
	if not value:failures.append(label)
func begin_reply(command: Dictionary,token: int) -> Dictionary:
	return {"kind":"native-action-result","action":"native-level-up","operation":"begin","accepted":true,"levelRequest":JSON.parse_string(JSON.stringify(command.levelRequest)),"result":{"token":token,"snapshot":{"actorId":42,"classes":[{"id":0,"level":3}],"skills":[]},"available":[true],"protocolFeatures":{"multiclassRuleset":true}}}
func open_entry(controller,desktop,view,token: int) -> Dictionary:
	view.reset();view.open();controller.input({"kind":"level-open"})
	var command: Dictionary=desktop.commands.back().duplicate(true);controller.receive_result(begin_reply(command,token));return command
func _initialize() -> void:run.call_deferred()
func run() -> void:
	var output:=""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--report="):output=arg.trim_prefix("--report=")
	if output.is_empty() or FileAccess.file_exists(output):quit(2);return
	var desktop:=Desktop.new();var view:=View.new();var controller:=Controller.new();controller.configure(desktop,view)
	var one:=open_entry(controller,desktop,view,11)
	check(view.wanted and controller.token==11 and desktop.commands.size()==1,"Actual begin input/result opens its own token")
	var two:=open_entry(controller,desktop,view,12)
	check(controller.token==12 and two.levelRequest.request>one.levelRequest.request,"New same-actor entry has its own request")
	controller.receive_result(begin_reply(one,11))
	check(controller.token==12 and view.wanted,"Late old begin cannot replace current token")
	controller.receive_result(begin_reply(two,99))
	check(controller.token==12,"Duplicate consumed begin cannot relabel the token")
	check(controller.send_level_request({"kind":"native-level-up","operation":"submit","token":12,"proposal":{}}),"Actual submission captures its current local scope")
	var submitted: Dictionary=desktop.commands.back().duplicate(true)
	var three:=open_entry(controller,desktop,view,13)
	var late:={"kind":"native-action-result","action":"native-level-up","operation":"submit","accepted":true,"levelRequest":submitted.levelRequest.duplicate(true),"result":{"accepted":true}}
	controller.receive_result(late)
	check(controller.token==13 and view.wanted,"Old successful submission cannot close a newer presentation")
	var missing:=begin_reply(three,98);missing.erase("levelRequest");controller.receive_result(missing)
	check(controller.token==13,"Uncorrelated reply cannot mutate an open entry")
	var route:=NativeDesktop.new();route.level_owner=controller;route.target_prompt=Label.new();route.add_child(route.target_prompt);route.target_prompt.hide()
	var stale_failure:=begin_reply(one,11);stale_failure.accepted=false;stale_failure.text="Stale transport failure";var prior_status: String=controller.status
	route.receive(stale_failure)
	check(not route.target_prompt.visible and controller.status==prior_status and controller.token==13,"Actual Desktop suppresses stale global level-up refusal prompt")
	view.reset();view.open();controller.input({"kind":"level-open"});var current: Dictionary=desktop.commands.back().duplicate(true)
	var refused:=begin_reply(current,14);refused.accepted=false;refused.text="Current validation refusal";route.receive(refused)
	check(view.wanted and view.status.text=="Current validation refusal" and not route.target_prompt.visible,"Current refusal reaches its level-up owner without a global prompt")
	var four:=open_entry(controller,desktop,view,14)
	check(controller.send_level_request({"kind":"native-level-up","operation":"submit","token":14,"proposal":{}}),"Current submit is issued")
	var accepted:={"kind":"native-action-result","action":"native-level-up","operation":"submit","accepted":true,"levelRequest":desktop.commands.back().levelRequest.duplicate(true),"result":{"accepted":true}}
	route.receive(accepted)
	check(not view.wanted and controller.token==-1,"Only the current successful submission closes its UI")
	var five:=open_entry(controller,desktop,view,15);var count:=desktop.commands.size();desktop.native_lifetime+=1
	check(not controller.send_level_request({"kind":"native-level-up","operation":"submit","token":15,"proposal":{}}) and desktop.commands.size()==count,"ID reuse cannot send an old UI proposal to a new entity lifetime")
	controller.observe_received()
	check(not view.wanted and controller.token==-1 and desktop.commands.size()==count,"Received lifetime retirement closes only presentation without cancelling another actor")
	open_entry(controller,desktop,view,16)
	controller.source_command({"kind":"native-level-up","operation":"submit","token":16,"proposal":{}},controller.source_identity())
	var pending_submit: Dictionary=desktop.commands.back().duplicate(true);count=desktop.commands.size()
	controller.input({"kind":"level-cancel"})
	check(desktop.commands.size()==count+1 and desktop.commands.back().operation=="cancel" and not view.wanted,"Presentation Cancel keeps original cancellation command semantics after send")
	controller.receive_result({"accepted":true,"operation":"submit","levelRequest":pending_submit.levelRequest,"result":{"accepted":true}})
	check(not view.wanted,"Genuine pending submission result can retire without reopening its closed presentation")
	controller.receive_result(begin_reply(five,15));check(not view.wanted,"Cancelled presentation cannot be resurrected")
	check(four.levelRequest.entry!=three.levelRequest.entry,"Per-entry identity remains distinct across resets")
	route.closed=true;route.free();controller.close();view.presentation_reset.disconnect(controller.retire_source);view.source_reopen.disconnect(controller.reopen_source)
	var file:=FileAccess.open(output,FileAccess.WRITE);file.store_string(JSON.stringify({"success":failures.is_empty(),"checks":checks,"failures":failures,"productionFixed":true,"serverConnections":0,"gpu":false,"scope":"Actual NativeLevelUp input/receive_result/reset/current actor lifetime and NativeDesktop.receive routing, render-only controller override and authored delayed local replies echoing real outgoing metadata. No original server, native pixels or HP mutation claim."},"\t"));file.close();quit(0 if failures.is_empty() else 1)
