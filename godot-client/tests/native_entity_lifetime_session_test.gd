extends "res://tests/native_entity_api_session_test.gd"
# Replays exact frames generated by real JS World/delta/framing code. Canonical
# native UI/motion owners remain the explicit authored parent-test boundaries.
func run() -> void:
	var output:="";var trace_path:=""
	for argument in OS.get_cmdline_user_args():
		if argument.begins_with("--report="):output=argument.trim_prefix("--report=")
		if argument.begins_with("--trace="):trace_path=argument.trim_prefix("--trace=")
	if output.is_empty() or trace_path.is_empty() or FileAccess.file_exists(output):quit(2);return
	var trace: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(trace_path))
	check(trace.success and trace.stages.size()==10,"Actual JS World/raw-delta/framing fixture produced all lifecycle boundaries")
	host=Node3D.new();root.add_child(host);render_settings=Settings.new();host.add_child(render_settings);render_menu=Menu.new();host.add_child(render_menu);world_retirement=WorldRetirement.new();host.add_child(world_retirement);transition_targets=Transitions.new()
	session_connection=1;install_entity_api();var provider: RefCounted=ClientAPI.entities
	var reference: Variant=null;var first_reference: Variant=null;var current_row: Dictionary={};var actor:=int(trace.objectId);var current_generation:=-1;var current_area:=-1
	var lifecycle_events: Array=[]
	provider.entity_removed.connect(func(event):lifecycle_events.append(["removed",event.duplicate(true)]))
	provider.entity_added.connect(func(event):lifecycle_events.append(["added",event.duplicate(true)]))
	for stage in trace.stages:
		if int(stage.connection)!=session_connection:
			reset_session();session_connection=int(stage.connection);cancelled_connection=-1;current_generation=-1
		if current_generation<0:
			prepare_owners(int(stage.generation),int(stage.area))
		else:
			world.area_id=int(stage.area);world.generation=int(stage.generation);gameplay_ui.generation=int(stage.generation);gameplay_ui.area_id=int(stage.area);epoch=int(stage.generation)
		current_generation=int(stage.generation);current_area=int(stage.area)
		var before_count:=requests.size();var before_boundary: int=provider.diagnostics().boundaries;lifecycle_events.clear()
		for frame in stage.frames:
			fixture_serial=int(frame.serial)
			receive(frame)
			if frame.kind=="raw-world-chunk":
				for row in frame.objects:
					if int(row.id)==actor and not row.get("replicationRemoved",false):current_row=row.duplicate(true)
		if stage.frames.is_empty():
			check(requests.size()==before_count and provider.diagnostics().boundaries==before_boundary and provider.resolve(reference)!=null,"No bridge publication for unchanged/rejected transaction: "+str(stage.name));continue
		check(not closing and accepted_raw_serial==fixture_serial and requests.size()==before_count+1 and requests.back().kind=="raw-world-accepted","Actual session preserves original core ACK for producer frame: "+str(stage.name))
		if stage.expected=="removed":
			check(provider.get_reference(actor)==null and provider.resolve(reference)==null,"Actual accepted D retires client-known API entity despite retained proxy");continue
		var current: Dictionary=provider.get_reference(actor)
		check(not current.is_empty() and provider.resolve(current)!=null,"Exact producer frame exposes a previsual entity: "+str(stage.name))
		var view: Dictionary=provider.resolve(current)
		check(view.client_data.disclosure_lifetime.source=="client_disclosure_run" and view.client_data.disclosure_lifetime.value==stage.disclosure and not view.received.value.has("clientKnownLifetime"),"Disclosure token remains detached client metadata rather than server stats: "+str(stage.name))
		if reference!=null and stage.expected in ["replaced","scope","new"]:
			check(provider.resolve(reference)==null and current!=reference,"Old scoped reference cannot resolve across producer lifecycle: "+str(stage.name))
		if stage.expected=="replaced":
			check(lifecycle_events.filter(func(event):return int(event[1].object_id)==actor).map(func(event):return event[0])==["removed","added"],"Coalesced retained proxy replacement emits detached remove then add: "+str(stage.name))
			var detached: Dictionary=lifecycle_events[0][1];detached.reference.lifetime=999
			check(provider.resolve(current)!=null,"Consumer event mutation cannot alter replacement lifetime")
		if first_reference==null:first_reference=current.duplicate(true)
		reference=current.duplicate(true)
	check(provider.get_scope().connection==2 and provider.get_scope().area_generation==0 and provider.resolve(first_reference)==null,"Reconnection may reuse numeric disclosure counter without reviving an earlier connection reference")
	# Explicit tagged exhaustion/malformed metadata must never use nativeLifetime
	# as a fallback. The real non-gating session observer invalidates API only.
	for invalid in [null,0,-1,1.5,"2",true,{},[],9007199254740992]:
		var bad: Dictionary=current_row.duplicate(true);bad.clientKnownLifetime=invalid;var old_reference: Dictionary=provider.get_reference(actor);var ack_count:=requests.size()
		feed([bad],"full",[],current_generation,current_area,actor)
		check(not closing and requests.size()==ack_count+1 and accepted_raw_serial==fixture_serial and requests.back().kind=="raw-world-accepted","Malformed explicit disclosure token cannot fail gameplay or suppress its original ACK")
		check(not provider.get_scope().active and provider.resolve(old_reference)==null and report.entity_api_observer.last_reason=="binding_rejected","Malformed/exhausted explicit token invalidates API references without renderer fallback")
		feed([current_row],"full",[],current_generation,current_area,actor)
		check(provider.get_scope().active and provider.get_reference(actor)!=null,"A valid complete producer boundary restores the read-only observer")
	var legacy: Dictionary=current_row.duplicate(true);legacy.erase("clientKnownLifetime");feed([legacy],"full",[],current_generation,current_area,actor)
	var legacy_ref: Variant=provider.get_reference(actor)
	check(legacy_ref!=null and provider.resolve(legacy_ref)!=null and not provider.resolve(legacy_ref).client_data.disclosure_lifetime.available,"Legacy rows retain nativeLifetime compatibility with disclosure metadata explicitly unavailable")
	legacy.clientKnownLifetime=legacy.nativeLifetime;feed([legacy],"full",[],current_generation,current_area,actor)
	check(legacy_ref!=null and provider.resolve(legacy_ref)==null,"Explicit source tag keeps equal numeric renderer/disclosure counters in separate namespaces")
	reset_session();world_retirement.close();host.free();host=null;world=null;gameplay_ui=null;await process_frame;await process_frame
	var result:={"success":failures.is_empty(),"checks":checks,"failures":failures,"publicConnections":0,"gameServerConnections":0,"gpu":false,"nativeBuilds":0,"scope":"Actual NetworkWorld-produced raw delta/framing JSON replay through real native_session_world receive/ACK/non-gating observer and ClientAPI; native raw UI/world/motion owners authored, no live client/server/render acceptance"}
	var file:=FileAccess.open(output,FileAccess.WRITE);file.store_string(JSON.stringify(result,"  ")+"\n");file.close();print("ENTITY_LIFETIME_SESSION_RESULT ",JSON.stringify(result));quit(0 if result.success else 1)
