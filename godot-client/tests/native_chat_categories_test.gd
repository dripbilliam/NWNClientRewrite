extends "res://tests/native_chat_adjustable_test.gd"
const Categories=preload("res://systems/native_data/chat_categories.gd")
func right_click(surface: SubViewport,control: Control) -> void:
	var point:=control.get_global_rect().get_center(); var motion:=InputEventMouseMotion.new(); motion.position=point; motion.global_position=point; surface.push_input(motion,true); await frames()
	for pressed in [true,false]:
		var event:=InputEventMouseButton.new(); event.position=point; event.global_position=point; event.button_index=MOUSE_BUTTON_RIGHT; event.pressed=pressed; surface.push_input(event,true); await frames()
func adjustments(frame,chat,surface,art,args) -> void:
	await super.adjustments(frame,chat,surface,art,args)
	var retained: Dictionary=frame.preferences.duplicate(true)
	var research: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(str(args.get("oracle","res://reports/native-chat-categories-research-v1.json"))))
	check(research.binarySha256==BINARY_SHA,"Category research is pinned to the unchanged original binary")
	for pair in research.nativeSpeechCategories:
		check(Categories.speech(int(pair[0]))==int(pair[1]),"Original77c140 speech category for channel "+str(int(pair[0])))
	check(Categories.bits({"system":true,"category":"attack-feedback"})==0x80 and Categories.bits({"channel":5})==0x20 and Categories.speech(7)==0,"Combat feedback and server speech remain distinct; script sound is not chat")
	check(frame.owner_ui.text.base.open_file(str(args.install)+"/lang/en/data/dialog.tlk"),"Actual original TLK supplies chat radial labels")
	var catalog:=Catalog.new(); check(catalog.mount_install(args.install),"Original chat radial catalog opens read-only")
	var parser:=Actor.new(); var source:=parser.parse(catalog.get_resource("gui_ra_menu",2002)); check(parser.failure.is_empty(),"Actual radial model is decoded for chat context geometry")
	frame.context.layout_prepared(frame.context.layout_job,{"error":"","value":source})
	check(frame.context.layout_ready and frame.context.hooks.has("6hook"),"Chat context uses authored radial hooks through the shared wheel")
	chat.reset(); frame.original_preset(); frame.set_split(true); await frames()
	for row in [{"text":"Old talk","channel":1},{"text":"Shout","channel":2},{"text":"Whisper","channel":3},{"text":"Tell","channel":4},{"text":"Party","channel":6},{"text":"DM variant","channel":17},{"text":"Server","channel":5},{"text":"Combat","system":true,"category":"attack-feedback"},{"text":"Notice","system":true,"chat_mask":0x10000000}]: chat.append_message(row)
	await frames(4)
	var left: String=frame.panes[0].label.get_parsed_text(); var right: String=frame.panes[1].label.get_parsed_text()
	check(left=="Old talk\nShout\nWhisper\nTell\nParty\nDM variant\n" and right=="Server\nCombat\nNotice\n","Default original split masks classify actual received rows, including DM and status categories")
	var sent:=requests.size(); await right_click(surface,frame.panes[0].handle)
	check(frame.context.active and frame.context.entries.size()==7 and frame.context.entries[0].label=="Combine Chat Windows" and frame.context.entries[0].icon=="ir_chatsplit","Actual right-click opens the original seven-entry chat radial with localized mode action")
	check(frame.context.buttons[4].tooltip_text.begins_with("Exclude Normal Chat") and frame.context.buttons[5].tooltip_text.begins_with("Include Combat Info") and frame.context.layer==100 and frame.blocks_pointer(frame.context.origin),"Native per-pane inclusion state controls the radial labels and top input layer")
	await button(surface,frame.context.buttons[4]); await frames()
	check(not frame.context.active and frame.preferences.mask_left==0x74e and frame.preferences.mask_right==0x100000b0 and requests.size()==sent,"Actual Normal Chat action changes only this pane's local category mask and sends no gameplay request")
	chat.append_message({"text":"Excluded new talk","channel":1}); chat.append_message({"text":"New whisper","channel":3}); await frames(4)
	left=frame.panes[0].label.get_parsed_text()
	check(left.contains("Old talk") and not left.contains("Excluded new talk") and left.contains("New whisper"),"Original category toggles affect future admission without rewriting already displayed history or hiding Whisper")
	frame.apply_preferences(frame.preferences.duplicate()); await frames()
	check(not frame.panes[0].label.get_parsed_text().contains("Old talk") and frame.panes[0].label.get_parsed_text().contains("New whisper"),"Explicit source-history rebuild applies the current mask to retained messages")
	await right_click(surface,frame.panes[0].handle); await button(surface,frame.context.buttons[2]); chat.append_message({"text":"Shared server line","channel":5}); await frames(4)
	check(frame.panes[0].label.get_parsed_text().contains("Shared server line") and frame.panes[1].label.get_parsed_text().contains("Shared server line"),"One received server message can appear in both panes when both original masks admit it")
	await right_click(surface,frame.panes[1].handle); await button(surface,frame.context.buttons[2]); chat.append_message({"text":"Left-only server line","channel":5}); await frames(4)
	check(frame.panes[0].label.get_parsed_text().contains("Left-only server line") and not frame.panes[1].label.get_parsed_text().contains("Left-only server line") and frame.panes[1].label.get_parsed_text().contains("Shared server line"),"Secondary context filters are independent and preserve that pane's previously admitted text")
	var saved:=Preferences.load_settings(frame.storage)
	check(saved.mask_left==frame.preferences.mask_left and saved.mask_right==frame.preferences.mask_right,"Both original category masks survive persistence through the shared preferences file")
	await right_click(surface,frame.panes[0].handle); await button(surface,frame.context.buttons[0]); await frames(4)
	check(not frame.split and not frame.panes[1].container.visible and frame.preferences.mask_combined==0xffffffff and frame.panes[0].label.get_parsed_text().contains("Excluded new talk"),"Actual Combine action restores the original all-category mask and reconstructs combined history")
	await right_click(surface,frame.panes[0].handle)
	check(frame.context.entries[0].label=="Split Chat Window" and frame.context.entries[0].icon=="ir_chatcombine","Combined mode uses the opposite original label and authored icon")
	await button(surface,frame.context.buttons[0]); await frames()
	check(frame.split and frame.preferences.mask_left==0x74f and frame.preferences.mask_right==0x100000b0,"Actual Split action restores both original default masks")
	await right_click(surface,frame.panes[0].handle); var stale:={"kind":"radial-select","requestId":frame.context.request_id,"menuId":frame.context.menu_id,"slot":5}; frame.reset(); var mask: int=frame.preferences.mask_left; frame.context_request(stale)
	check(not frame.context.active and frame.preferences.mask_left==mask,"Reset retires an open chat radial and rejects its delayed selection")
	frame.owner_ui.presentation_enabled=false; frame.open_context(0,Vector2(200,200)); check(not frame.context.active,"Hidden gameplay cannot reopen the chat radial"); frame.owner_ui.presentation_enabled=true
	check(frame.panes[0].label.selection_enabled and frame.panes[0].label.shortcut_keys_enabled and not frame.panes[0].label.context_menu_enabled,"Chat enables native text selection/copy shortcuts while reserving right-click for its original wheel")
	frame.apply_preferences(retained); frame.save(); frame.options_window.reflect(frame.preferences); catalog=null; await frames()
