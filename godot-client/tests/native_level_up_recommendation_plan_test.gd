extends "res://tests/native_level_up_feats_test.gd"
const Plan=preload("res://systems/native_data/level_up_recommendation_plan.gd")
const FeatLoop=preload("res://systems/native_data/level_up_feat_recommendations.gd")
const Parser=preload("res://systems/native_data/two_da.gd")
func run() -> void:
	var args: Dictionary={}
	for arg in OS.get_cmdline_user_args():
		var pair:=arg.trim_prefix("--").split("=",true,1)
		if pair.size()==2:args[pair[0]]=pair[1]
	if not args.has("report") or FileAccess.file_exists(args.report):quit(2);return
	var parser:=Parser.new();var active:=tables();var received:={"race":0,"classes":[{"id":0,"level":20},{"id":1,"level":1}],"baseAbilities":[12,12,14,14,12,12],"feats":[0,60000],"skills":[1],"fieldD4":0};var retained:=received.duplicate(true);var ranks: Array=[3];var context:={"baseFortitude":3};var text:=Text.new()
	active.classfeats.orderedRows.append({"FeatIndex":"3","GrantedOnLevel":"0","List":"2"});active.classfeats.orderedRows.append({"FeatIndex":"4","GrantedOnLevel":"0","List":"2"})
	active.classes.orderedRows[0].Package="1";active.classes.orderedRows[0].SpellbookRestricted="1"
	var state:=State.new();state.configure(received,0,2,ranks,context);state.view.tables=active;var current:=state.snapshot(state.view,text)
	check(current.ready and current.source.normal==0 and current.source.bonus==1,"Actual advanced mode1 source supplies one real class-bonus counter")
	var preferences:=parser.parse_reference("2DA V2.0\nFeatIndex\n0 65540\n1 0xGG\n");var answer:=FeatLoop.apply(current.source,preferences,true,state.candidate)
	check(answer.ready and answer.selected==[4] and answer.remaining==0 and answer.reads==[0],"Native lowWORD recommendation stops before unreachable malformed INT after its CHAR budget is exhausted")
	state.selected=answer.selected;check(state.validate(active,text).valid,"Actual mode1 prerequisite/reservation/completeness validates the pure recommendation")
	state.configure(received,0,2,ranks,{"baseFortitude":2});state.view.tables=active;current=state.snapshot(state.view,text);preferences=parser.parse_reference("2DA V2.0\nFeatIndex\n0 4\n1 3\n");answer=FeatLoop.apply(current.source,preferences,true,state.candidate)
	check(answer.ready and answer.selected==[3] and answer.reads==[0,1],"Preference order uses the current copied Fortitude context rather than first-level assumptions")
	state.selected=answer.selected;check(state.validate(active,text).valid,"Rejected first preference does not reserve a slot or invalidate the accepted current mode1 choice")
	var source:={"normal":255,"bonus":1,"selected":[]};var calls: Array=[]
	answer=FeatLoop.apply(source,parser.parse_reference("2DA V2.0\nFeatIndex\n0 0xGG\n"),true,func(_source,id):calls.append(id);return {"ready":true,"allowed":true})
	check(answer.ready and answer.remaining==0 and answer.selected.is_empty() and answer.reads.is_empty() and calls.is_empty(),"Wrapped zero CHAR total never reads or executes the preference loop")
	source={"normal":1,"bonus":1,"selected":[]};answer=FeatLoop.apply(source,parser.parse_reference("2DA V2.0\nFeatIndex\n0 ****\n1 65539\n2 4\n3 0xGG\n"),true,func(_source,id):return {"ready":true,"allowed":true})
	check(answer.ready and answer.selected==[3,4] and answer.remaining==0 and answer.reads==[0,1,2],"Failed INT lookup skips; successful values narrow to WORD and decrement exactly once")
	answer=FeatLoop.apply(source,{},false,func(_source,_id):return {"ready":true,"allowed":true})
	check(answer.ready and answer.remaining==2 and answer.selected.is_empty(),"Failed preference load leaves all native budget unspent without filler")
	answer=FeatLoop.apply(source,parser.parse_reference("2DA V2.0\nFeatIndex\n"),true,func(_source,_id):return {"ready":true,"allowed":true})
	check(answer.ready and answer.remaining==2 and answer.selected.is_empty(),"Successfully loaded zero rows is a distinct native empty traversal")
	check(not FeatLoop.apply(source,parser.parse_reference("2DA V2.0\nFeatIndex\n0 0xGG\n"),true,func(_source,_id):return {"ready":true,"allowed":true}).ready,"Reached unresolved conversion remains unavailable")
	var package_tables:=active.duplicate(true);package_tables.packages=parser.parse_reference("2DA V2.0\nFeatPref2DA SpellPref2DA\n0 FirstFeat FirstSpell\n1 LaterFeat LaterSpell\n");package_tables.firstfeat={"orderedRows":[]};package_tables.firstspell={"orderedRows":[]};package_tables.laterfeat={"orderedRows":[]};package_tables.laterspell={"orderedRows":[]}
	var selected:=Plan.feats(received,0,package_tables);check(selected.ready and selected.invoked and selected.loaded and selected.name=="firstfeat" and selected.context.classIndex==0,"Mode1 slot0 uses copied received Package rather than active class Package1")
	var later:=received.duplicate(true);later.classes=[{"id":1,"level":1}];selected=Plan.feats(later,0,package_tables)
	check(selected.ready and selected.name=="laterfeat" and selected.context.classIndex==1,"Appended class uses the selected native class Package field")
	package_tables.erase("firstfeat");selected=Plan.feats(received,0,package_tables)
	check(not selected.ready and selected.pending and selected.invoked and selected.dependencies==["firstfeat"],"Successful native String lookup precedes and marks pending preference load/reset")
	package_tables.firstfeat={};selected=Plan.feats(received,0,package_tables)
	check(selected.ready and selected.invoked and not selected.loaded,"Known failed preference differs from unloaded and valid empty data")
	package_tables.packages=parser.parse_reference("2DA V2.0\nFeatPref2DA SpellPref2DA\n0 **** ****\n");selected=Plan.feats(received,0,package_tables)
	check(selected.ready and not selected.invoked,"Missing/empty FeatPref String cannot reset begun mode1 selections")
	var book:={"memorizes":true,"school":1};selected=Plan.spells(received,0,package_tables,book)
	check(selected.ready and not selected.helperInvoked,"Missing SpellPref String skips preference helper while preserving manual coordinator behavior")
	package_tables.packages={};selected=Plan.spells(received,0,package_tables,book)
	check(selected.ready and not selected.helperInvoked,"Failed Packages load remains a real skipped-helper plan, not a fabricated preference")
	package_tables.packages=parser.parse_reference("2DA V2.0\nFeatPref2DA SpellPref2DA\n0 FirstFeat FirstSpell\n");package_tables.erase("firstspell");selected=Plan.spells(received,0,package_tables,book)
	check(not selected.ready and selected.pending and selected.helperInvoked and selected.invoked,"Pending SpellPref load preserves the successful String's second-reset boundary")
	package_tables.firstspell=parser.parse_reference("2DA V2.0\nSpellIndex\n0 65537\n1 ****\n");selected=Plan.spells(received,0,package_tables,book)
	check(not selected.ready and selected.pending and selected.helperInvoked and selected.dependencies==["spellschools"],"Mode1 private opposing-school resource can arrive after the preference table without losing reset ownership")
	package_tables.spellschools={"orderedRows":[{}, {"Opposition":"258"}]};selected=Plan.spells(received,0,package_tables,book)
	check(selected.ready and selected.helperInvoked and selected.loaded and selected.restricted and is_same(selected.preferenceTable,package_tables.firstspell) and selected.opposition==2,"Worker plan preserves physical spell preference rows for lazy INT traversal while active opposition narrows to its original BYTE")
	package_tables.firstspell={};selected=Plan.spells(received,0,package_tables,book)
	check(selected.ready and selected.helperInvoked and not selected.loaded and selected.preferenceTable.is_empty(),"Failed named SpellPref retains helper invocation/zero budget semantics for the original coordinator")
	package_tables.classes.orderedRows[0].SpellbookRestricted="0";package_tables.firstspell=parser.parse_reference("2DA V2.0\nSpellIndex\n0 0xGG\n");selected=Plan.spells(received,0,package_tables,{"memorizes":false,"school":0})
	check(selected.ready and selected.helperInvoked and not selected.restricted,"Unrestricted native class does not read the helper's unreachable malformed preference cells")
	check(received==retained and ranks==[3],"Mode1 plans and candidate execution preserve received actor and caller rank inputs")
	var file:=FileAccess.open(args.report,FileAccess.WRITE);file.store_string(JSON.stringify({"success":failures.is_empty(),"checks":checks,"failures":failures,"serverConnections":0,"gpu":false,"runtimeIntegrated":false,"scope":"NEW mode1-only recommendation plans and original preference-only Feats loop using actual mode1 snapshot/candidate/validation; slot0/later Package, native widths/counter short-circuit, String/reset/load/opposition boundaries. No imported actions, controls, server or pixel acceptance."},"\t"));file.close();quit(0 if failures.is_empty() else 1)
