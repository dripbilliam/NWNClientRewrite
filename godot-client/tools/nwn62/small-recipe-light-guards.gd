extends SceneTree
const Recipe=preload("res://.cache/nwn62/small-recipe-d/systems/native_render/native_model_recipe.gd")
const Light=preload("res://systems/native_render/model_point_light.gd")
var checks:=0
var failures: Array=[]
var rows: Array=[]
func _initialize() -> void:call_deferred("run")
func check(ok: bool,label: String) -> void:
	checks+=1
	if not ok:failures.append(label)
func probe(tag: String,configured: bool,active: bool) -> void:
	var root_node: Node3D=Node3D.new();var light: OmniLight3D=Light.new();root_node.add_child(light)
	if configured:light.configure({"color":[1.0,0.6,0.2],"radius":3.0,"multiplier":1.0})
	if active:light.native_slot=9
	var recipe: RefCounted=Recipe.new();var begun: bool=recipe.begin_capture(root_node);var status:="pending";var reason:=""
	if begun:
		while status=="pending":
			var step: Dictionary=recipe.capture_step(8,3000);status=str(step.status);reason=str(step.get("reason",""))
	var expected:="recipe-active-light-binding" if active else ("recipe-unconfigured-model-light" if not configured else "")
	check(begun and status==("failed" if not expected.is_empty() else "ready") and reason==expected,tag+" admission")
	rows.append({"case":tag,"name":str(light.name),"status":status,"reason":reason})
	root_node.free()
func run() -> void:
	probe("configured-detached",true,false)
	probe("active-slot",true,true)
	probe("missing-properties",false,false)
	var report:=""
	for arg in OS.get_cmdline_user_args():if arg.begins_with("--report="):report=arg.substr(9)
	var result: Dictionary={"success":failures.is_empty(),"checks":checks,"failures":failures,"rows":rows,"scope":"Private autogenerated light leaf admission only; no GPU/FPS."}
	var file: FileAccess=FileAccess.open(report,FileAccess.WRITE)
	if file!=null:file.store_string(JSON.stringify(result,"  "));file.close()
	print("NWN62_LIGHT_GUARDS "+JSON.stringify(result))
	quit(0 if failures.is_empty() else 1)
