extends RefCounted
# Pure CPU provenance for the Shader programs generated by NativeMaterial.
# No GeometryInstance property enumeration or RenderingServer getter. Unknown
# shaders stay on the ordinary renderer. Shader mutations invalidate forever.
const REVISION:="native-material-instance-contract-v1"
const TILE_FOG:="nwn_tile_fog_factor"
const MAX_PROGRAMS:=512
const MAX_CODE_BYTES:=131072
static var _programs: Dictionary={}
static var _registered:=0
static var _invalidated:=0
static var _retired:=0
static func _retire_dead() -> void:
	# Cold shader-construction boundary only, never a frame or mesh scan.
	for id in _programs.keys():
		if _programs[id].program.get_ref()==null:_programs.erase(id);_retired+=1
static func _program_changed(id: int) -> void:
	if _programs.has(id) and _programs[id].valid:
		_programs[id].valid=false;_invalidated+=1
static func register_program(program: Shader,source_code: String,tile_fog: bool) -> bool:
	if program==null or program.get_class()!="Shader" or program.get_script()!=null or source_code.is_empty() or source_code.length()>MAX_CODE_BYTES:return false
	var declaration:="instance uniform float "+TILE_FOG+"=1.0;"
	if source_code.count("instance uniform ")!=(1 if tile_fog else 0) or tile_fog and not source_code.contains(declaration):return false
	_retire_dead()
	var id:=program.get_instance_id()
	if _programs.has(id):return _programs[id].program.get_ref()==program and _programs[id].valid and _programs[id].tile_fog==tile_fog and _programs[id].code_sha256==source_code.sha256_text()
	if _programs.size()>=MAX_PROGRAMS:return false
	_programs[id]={"program":weakref(program),"valid":true,"tile_fog":tile_fog,"code_sha256":source_code.sha256_text()};_registered+=1
	program.changed.connect(_program_changed.bind(id),CONNECT_ONE_SHOT)
	return true
static func supports(program: Shader,tile_fog: bool,allow_tile_fog: bool=false) -> bool:
	if program==null:return false
	var row: Dictionary=_programs.get(program.get_instance_id(),{})
	return not row.is_empty() and row.program.get_ref()==program and row.valid and row.tile_fog==tile_fog and (allow_tile_fog or not tile_fog)
static func describe(program: Shader) -> Dictionary:
	var row: Dictionary=_programs.get(program.get_instance_id(),{}) if program!=null else {}
	if row.is_empty() or row.program.get_ref()!=program:return {"available":false,"reason":"unowned-shader"}
	return {"available":bool(row.valid),"revision":REVISION,"code_sha256":str(row.code_sha256),"parameters":[TILE_FOG] if row.tile_fog else [],"reason":"owned-program" if row.valid else "program-mutated"}
static func snapshot() -> Dictionary:
	return {"revision":REVISION,"entries":_programs.size(),"maximum_entries":MAX_PROGRAMS,"registered":_registered,"invalidated":_invalidated,"retired":_retired,"scope":"Weak Shader identity + once-recorded code hash, fixed known uniform declaration; no property reflection, rendering readback or live mesh state"}
