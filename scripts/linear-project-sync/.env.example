# Copy to .env in this directory; .env files are ignored by Git.
# Fill secrets locally or use repository Actions secrets. Never commit real keys.
LINEAR_API_KEY=replace-with-read-only-key
GH_PROJECT_TOKEN=replace-with-project-scope-token

GH_PROJECT_OWNER=dripbilliam
GH_PROJECT_OWNER_TYPE=user
GH_PROJECT_NUMBER=3
# Set at least one UUID. Setting both intersects team and project.
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=

SYNC_NAMESPACE=nwnanalog-public-roadmap
PUBLICATION_MODE=label
LINEAR_PUBLIC_LABEL=public
DESCRIPTION_MODE=title-only
STATUS_MAPPING_JSON='{"Canceled":"Canceled","Duplicate":"Canceled"}'
UNKNOWN_STATUS_POLICY=skip
STATUS_FALLBACK=Backlog
GH_STATUS_FIELD=Status
REMOVAL_POLICY=leave
ARCHIVE_STATUS=Canceled
MAX_REMOVALS=10
ALLOW_EMPTY_SOURCE_REMOVALS=false
PUBLISH_ARCHIVED_ISSUES=false
REQUIRE_PUBLIC_PROJECT=true
SYNC_PAGE_SIZE=50
SYNC_MAX_PAGES=1000
SYNC_MAX_RETRIES=4
SYNC_REQUEST_TIMEOUT_MS=30000
